{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DrakeStar",
  "version": "0.6.0",
  "identifier": "net.drakes.drakestar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DrakeStar",
        "width": 1100,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://mc-heads.net https://minotar.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both"
      }
    },
    "shortDescription": "Launcher de Minecraft de DrakesCraft",
    "category": "Game"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SlimefunNewHorizons/DrakeStar-Launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNkE3NjE0RDcwNTUxMDcKUldRSFVRWFhGSFpxOE1hTzNWN045KzRrcjlWcjJOK2xoNzYxcTJaMmRyL09ka3dXUUpVWmsrSmYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}