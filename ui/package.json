{
  "name": "drakestar-ui",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "predev": "npm run sync-brand",
    "dev": "vite",
    "prebuild": "npm run sync-brand",
    "build": "svelte-check --tsconfig ./tsconfig.json && npm run test:diagnostics && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:diagnostics": "node tests/diagnostics.mjs",
    "test:catalog": "node --test tests/catalog.mjs",
    "test:starling": "node --test tests/starling_ui.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/catalog.mjs tests/starling_ui.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@tsconfig/svelte": "^5",
    "playwright": "1.58.2",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
